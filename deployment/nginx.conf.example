# Merge into your existing reverse-proxy configuration after checking its current routes.
# Use a certificate already issued for this hostname; replace both certificate paths.
server {
    listen 80;
    server_name al-rifai.iamazim.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name al-rifai.iamazim.com;
    ssl_certificate /ABSOLUTE/PATH/fullchain.pem;
    ssl_certificate_key /ABSOLUTE/PATH/privkey.pem;
    client_max_body_size 16m;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 180s;
    }
}
