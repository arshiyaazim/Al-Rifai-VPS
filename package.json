{
  "name": "al-rifai-vps",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node --experimental-strip-types --env-file-if-exists=.env server/index.mjs",
    "db:migrate": "node --env-file-if-exists=.env database/migrate.mjs",
    "user:create": "node --env-file-if-exists=.env scripts/create-user.mjs",
    "test": "node tests/run.mjs",
    "mcp:consume": "node --env-file-if-exists=.env integrations/mcp-consumer.mjs",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "^1.31.0",
    "zod": "^3.25.76",
    "tw-animate-css": "^1.4.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "vite": "8.0.13",
    "typescript": "5.9.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@tailwindcss/postcss": "4.2.1",
    "tailwindcss": "4.2.1",
    "@electric-sql/pglite": "0.5.10"
  }
}
